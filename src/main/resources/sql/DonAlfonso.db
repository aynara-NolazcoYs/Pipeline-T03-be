-- Verifica si la base de datos DonAlfonsoDB existe; si no, la crea
IF DB_ID('DonAlfonsoDB') IS NULL
BEGIN
    CREATE DATABASE DonAlfonsoDB;
END
GO

-- Selecciona la base de datos DonAlfonsoDB para trabajar en ella
USE DonAlfonsoDB;
GO

-- Verifica si la tabla CLIENTE existe; si existe, la elimina
IF OBJECT_ID('dbo.CLIENTE', 'U') IS NOT NULL
BEGIN
    DROP TABLE dbo.CLIENTE;
END
GO

-- Crea la tabla CLIENTE con sus columnas y tipos de datos
CREATE TABLE dbo.CLIENTE (
    identificador INT IDENTITY(1,1) NOT NULL PRIMARY KEY, -- Clave primaria autoincremental
    nombre VARCHAR(150) NOT NULL,                          -- Nombre del cliente
    celular CHAR(9) NOT NULL,                              -- Número de celular (9 dígitos)
    correo VARCHAR(150) NOT NULL,                          -- Correo electrónico
    ruc CHAR(11) NOT NULL,                                 -- RUC del cliente (11 dígitos)
    direccion VARCHAR(200) NOT NULL,                       -- Dirección del cliente
    estado CHAR(1) NOT NULL DEFAULT 'A'                   -- Estado del cliente: 'A'ctivo o 'I'nactivo, por defecto 'A'
);
GO

-- Agrega una restricción CHECK para validar que el estado solo pueda ser 'A' o 'I'
ALTER TABLE dbo.CLIENTE
ADD CONSTRAINT CK_CLIENTE_ESTADO
CHECK (estado IN ('A', 'I'));
GO

-- Agrega una restricción UNIQUE para que el RUC sea único en la tabla
ALTER TABLE dbo.CLIENTE
ADD CONSTRAINT UQ_CLIENTE_RUC UNIQUE (ruc);
GO

