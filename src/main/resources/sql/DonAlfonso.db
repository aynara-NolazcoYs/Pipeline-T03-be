-- Selecciona todos los registros de la tabla CLIENTE
-- Esto permite ver los datos que acabamos de insertar
SELECT *
FROM dbo.CLIENTE
ORDER BY identificador; -- Ordena los resultados por la clave primaria para mayor claridad
GO

-- Verifica si la tabla PRODUCTOS existe; si existe, la elimina
IF OBJECT_ID('dbo.PRODUCTOS', 'U') IS NOT NULL
BEGIN
    DROP TABLE dbo.PRODUCTOS;
END
GO

-- Crea la tabla PRODUCTOS con sus columnas y tipos de datos
CREATE TABLE dbo.PRODUCTOS (
    id BIGINT IDENTITY(1,1) NOT NULL PRIMARY KEY,           -- Clave primaria autoincremental
    nombre VARCHAR(100) NOT NULL,                            -- Nombre del producto
    descripcion VARCHAR(255),                                -- Descripción del producto
    tipo VARCHAR(50),                                        -- Tipo de producto
    stock VARCHAR(50),                                       -- Stock disponible
    estado CHAR(1) NOT NULL DEFAULT 'A',                     -- Estado: 'A'ctivo o 'I'nactivo
    created_at DATETIME DEFAULT GETDATE(),                   -- Fecha de creación
    updated_at DATETIME,                                     -- Fecha de actualización
    deleted_at DATETIME,                                     -- Fecha de eliminación lógica
    restored_at DATETIME                                     -- Fecha de restauración
);
GO

-- Agrega una restricción CHECK para validar que el estado solo pueda ser 'A' o 'I'
ALTER TABLE dbo.PRODUCTOS
ADD CONSTRAINT CK_PRODUCTOS_ESTADO
CHECK (estado IN ('A', 'I'));
GO

